---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="projects-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>

  {% unless page.url == '/projects/' %}
    <div
      class="buymeabeer-project"
      style="display:flex; flex-direction:column; justify-content:center; align-items:center; gap:12px; text-align:center;"
    >
      <span>🍺 If this project has been helpful and you enjoy what I do and want to support me I would really appriciate it! 🔽</span>

      <a href="https://www.buymeacoffee.com/professorshroom" target="_blank" rel="noopener" style="display:inline-block;">
        <span>
          {% include images.liquid id="supportme" class="supportme-img" %}
        </span>
      </a>
    </div>
  {% endunless %}

  {% if page.related_projects %}
    <hr>

    <div class="related-projects-title">
      <h3>Related projects</h3>
    </div>

    <div class="related-projects">
      {% assign related_list = '' | split: ',' %}

      {% for project in site.projects %}
        {% if project.url != page.url %}
          {% assign match = false %}

          {% if project.related_projects %}
            {% for key in project.related_projects %}
              {% if page.related_projects contains key %}
                {% assign match = true %}
              {% endif %}
            {% endfor %}
          {% endif %}

          {% if match %}
            {% assign importance = project.importance | default: 999 %}

            {%- comment -%}
              Pad importance so string sorting works correctly:
              001, 002, 010, 099, 999
            {%- endcomment -%}
            {% assign importance_padded = importance | prepend: '000' | slice: -3, 3 %}

            {% capture sortable %}
{{ importance_padded }}||{{ project.title }}||{{ project.url }}||{{ project.description }}||{{ project.img }}
          {% endcapture %}

            {% assign related_list = related_list | push: sortable %}
          {% endif %}
        {% endif %}
      {% endfor %}

      {% assign related_list = related_list | sort %}

      {% assign found = false %}

      {% for item in related_list %}
        {% assign found = true %}
        {% assign parts = item | split: '||' %}

        <a class="related-project-card" href="{{ parts[2] | relative_url }}">
          <div class="related-projects-item">
            {% if parts[4] != blank %}
              <div class="related-projects-image">
                <img src="{{ parts[4] | relative_url }}" alt="{{ parts[1] }}">
              </div>
            {% endif %}

            <div class="related-projects-content">
              <div class="related-projects-title">
                {{ parts[1] }}
              </div>

              {% if parts[3] != blank %}
                <div class="related-projects-desc">
                  {{ parts[3] }}
                </div>
              {% endif %}
            </div>
          </div>
        </a>
      {% endfor %}

      {% if found == false %}
        <p>
          No related projects.<br>
          Explore more projects on the <a href="/projects/">projects page</a>.
        </p>
      {% endif %}
    </div>
  {% endif %}
  <br>
  {% if page.related_posts %}
    <div class="related-posts-title">
      <h3>Related posts</h3>
    </div>

    <div class="related-posts">
      {% assign found = false %}

      {% for post in site.posts %}
        {% assign match = false %}

        {% for tag in post.tags %}
          {% if page.related_posts contains tag %}
            {% assign match = true %}
          {% endif %}
        {% endfor %}

        {% if match %}
          {% assign found = true %}

          <div class="related-post-item">
            <a href="{{ post.url | relative_url }}">
              {{ post.title }}
            </a>

            <span class="related-post-date">
              — {{ post.date | date: '%-d' }}
              <sup>
                {%- assign d = post.date | date: '%-d' -%}
                {%- case d -%}
                  {%- when '1', '21', '31' -%}
                    st
                  {%- when '2', '22' -%}
                    nd
                  {%- when '3', '23' -%}
                    rd
                  {%- else -%}
                    th
                {%- endcase -%}
              </sup>
              of {{ post.date | date: '%B %Y' }}
            </span>
          </div>
        {% endif %}
      {% endfor %}

      {% if found == false %}
        <p>
          No related posts.<br>
          Explore more posts on the <a href="/posts/">posts page</a>.
        </p>
      {% endif %}
    </div>
  {% endif %}
  {% if page.comments %}
    <div id="giscus-container" style="margin-top: 40px;">
      <script
        src="https://giscus.app/client.js"
        data-repo="professorshroom/professorshroom-comments"
        data-repo-id="R_kgDOPH6XnA"
        data-category="Announcements"
        data-category-id="DIC_kwDOPH6XnM4Csjos"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="preferred_color_scheme"
        data-lang="en"
        crossorigin="anonymous"
        async
      ></script>
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
