---
layout: default
---
{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="projects-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.gallery_mode %}
    {% assign all_items = site.data.images.images_list %}

    {% assign album_list = '' | split: '' %}
    {% assign album_order = '' | split: '' %}

    {%- comment -%} STEP 1: COLLECT ALBUMS {%- endcomment -%}

    {% for item in all_items %}
      {% if item.gallery == true and item.items %}
        {% assign has_visible = false %}

        {% for image in item.items %}
          {% if image.exclude != true %}
            {% if image.path == 'assets/img/placeholder.png' %}
              {% continue %}
            {% endif %}

            {%- comment -%}
              FIX: zero-pad sort key so string sort works correctly
            {%- endcomment -%}
            {% assign has_visible = true %}
          {% endif %}
        {% endfor %}

        {% if has_visible %}
          {% assign order = item.order | default: 9999 | plus: 0 %}

          {% unless album_list contains item.album %}
            {% assign album_list = album_list | push: item.album %}
            {% assign album_order = album_order | push: order %}
          {% endunless %}
        {% endif %}
      {% endif %}
    {% endfor %}

    {%- comment -%} STEP 2: SORT ALBUMS {%- endcomment -%}

    {% assign sorted_albums = '' | split: '' %}
    {% assign used = '' | split: '' %}
    {% assign size = album_list.size | minus: 1 %}

    {% for i in (0..size) %}
      {% assign min_index = -1 %}
      {% assign min_value = 99999 %}

      {% for j in (0..size) %}
        {% unless used contains j %}
          {% assign val = album_order[j] | plus: 0 %}

          {% if val < min_value %}
            {% assign min_value = val %}
            {% assign min_index = j %}
          {% endif %}
        {% endunless %}
      {% endfor %}

      {% assign sorted_albums = sorted_albums | push: album_list[min_index] %}
      {% assign used = used | push: min_index %}
    {% endfor %}

    {%- comment -%} STEP 3: RENDER ALBUMS {%- endcomment -%}

    {% for album in sorted_albums %}
      <h2 class="mt-5">{{ album }}</h2>

      {% assign ordered = '' | split: '' %}
      {% assign unordered = '' | split: '' %}

      {%- comment -%} COLLECT IMAGES {%- endcomment -%}

      {% for item in all_items %}
        {% if item.gallery == true and item.items %}
          {% if item.album == album %}
            {% for image in item.items %}
              {% if image.exclude != true %}
                {%- comment -%}
                  FIX: zero-pad sort key so string sort works correctly
                {%- endcomment -%}

                {% assign order_num = image.image_order | default: 99999 | plus: 0 %}
                {% assign padded = order_num | prepend: '00000' | slice: -5, 5 %}

                {%- comment -%}
                  SAFE PATH VALIDATION (NEW)
                {%- endcomment -%}

                {% assign raw_path = image.path | default: '' | strip %}

                {%- comment -%} STRICT VALIDATION {%- endcomment -%}
                {% assign valid_extensions = 'jpg,jpeg,png,tiff,gif,webp' | split: ',' %}

                {% assign is_valid = false %}

                {% if raw_path != '' and raw_path contains '.' %}
                  {% assign filename_parts = raw_path | split: '/' %}
                  {% assign filename = filename_parts | last %}

                  {% if filename contains '.' %}
                    {% assign ext = filename | split: '.' | last | downcase %}

                    {% for v in valid_extensions %}
                      {% if v == ext %}
                        {% assign is_valid = true %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                {% endif %}

                {%- comment -%} SKIP INVALID FILES COMPLETELY {%- endcomment -%}
                {% unless is_valid %}
                  {% continue %}
                {% endunless %}

                {% assign entry = padded | append: '|' | append: raw_path | append: '|' | append: image.caption | append: '|' | append: image.title %}
                {% assign ordered = ordered | push: entry %}
              {% endif %}
            {% endfor %}
          {% endif %}
        {% endif %}
      {% endfor %}

      {%- comment -%} RELIABLE SORT {%- endcomment -%}

      {% assign images = ordered | sort %}

      <div class="row">
        {% for img in images %}
          {% assign parts = img | split: '|' %}
          {% assign path = parts[1] %}
          {% assign caption = parts[2] %}
          {% assign title = parts[3] %}

          <div class="col-sm-4 mt-3">
            <a href="/{{ path }}" data-lightbox="{{ album }}">
              <img
                src="/{{ path }}"
                class="img-fluid rounded image-shadow"
                alt="{{ caption }}"
                title="{{ title }}"
                onerror="this.onerror=null;this.src='{{ '/assets/img/placeholder.png' | relative_url }}';"
              >
            </a>

            {% if caption %}
              <div class="caption">
                {{ caption }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endfor %}
  {% endif %}
</div>
