{% assign target = include.id | append: '' %}
{% assign found = null %}
{% assign placeholder = null %}

{% assign all_groups = site.data.images.images_list %}

{%- comment -%} FIND IMAGE + PLACEHOLDER {%- endcomment -%}

{% for album in all_groups %}
  {% for image in album.items %}
    {% assign img_id = image.image_id | append: '' %}

    {% if img_id == target %}
      {% assign found = image %}
    {% endif %}

    {% if img_id == 'placeholder' %}
      {% assign placeholder = image %}
    {% endif %}
  {% endfor %}
{% endfor %}

{%- comment -%} VALIDATE PATH {%- endcomment -%}

{% assign valid_extensions = 'jpg,jpeg,png,tiff,gif,webp' | split: ',' %}
{% assign is_valid = false %}

{% if found and found.path != blank %}
  {% if found.path contains '.' %}
    {% assign ext = found.path | split: '.' | last | downcase %}

    {% for v in valid_extensions %}
      {% if v == ext %}
        {% assign is_valid = true %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}

{% unless is_valid %}
  {% assign found = placeholder %}
{% endunless %}

{%- comment -%} RENDER {%- endcomment -%}

{% if found %}
  {% if page.images and page.images.lightbox2 and include.no_lightbox != true and found.no_lightbox != true %}
    <a
      href="{% if include.url %}{{ include.url }}{% else %}{{ found.path | relative_url }}{% endif %}"
      data-lightbox="{{ page.url }}"
      {% if found.caption %}
        data-title="{{ found.caption }}"
      {% endif %}
    >
  {% endif %}

  {%
    include figure.liquid
    path=found.path
    caption=found.caption
    title=found.title
    class="img-fluid rounded z-depth-1"
    no_lightbox=found.no_lightbox
  %}

  {% if page.images and page.images.lightbox2 and include.no_lightbox != true and found.no_lightbox != true %}
    </a>
  {% endif %}
{% endif %}
