{% assign target = include.id | append: '' %}
{% assign found = null %}
{% assign placeholder = null %}

{% assign all_groups = site.data.images.images_list %}

{%- comment -%} FIND IMAGE + PLACEHOLDER {%- endcomment -%}

{% for album in all_groups %}
  {% for image in album.items %}
    {% assign img_id = image.image_id | append: '' %}

    {% if img_id == target %}
      {% assign found = image %}
    {% endif %}

    {% if img_id == 'placeholder' %}
      {% assign placeholder = image %}
    {% endif %}
  {% endfor %}
{% endfor %}

{%- comment -%} FALLBACK IF IMAGE ENTRY NOT FOUND {%- endcomment -%}

{% unless found %}
  {% assign found = placeholder %}
{% endunless %}

{%- comment -%} VALIDATE PATH FORMAT {%- endcomment -%}

{% assign valid_extensions = 'jpg,jpeg,png,tiff,gif,webp' | split: ',' %}
{% assign is_valid = false %}

{% if found and found.path != blank %}
  {% if found.path contains '.' %}
    {% assign ext = found.path | split: '.' | last | downcase %}

    {% for v in valid_extensions %}
      {% if v == ext %}
        {% assign is_valid = true %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}

{%- comment -%} FALLBACK IF INVALID EXTENSION/PATH {%- endcomment -%}

{% unless is_valid %}
  {% assign found = placeholder %}
{% endunless %}

{%- comment -%} PREPARE PATHS {%- endcomment -%}

{% assign image_path = found.path | relative_url %}
{% assign placeholder_path = placeholder.path | relative_url %}

{%- comment -%} RENDER {%- endcomment -%}

{% if found %}
  {% if page.images and page.images.lightbox2 and include.no_lightbox != true and found.no_lightbox != true %}
    <a
      href="{% if include.url %}{{ include.url }}{% else %}{{ image_path }}{% endif %}"
      data-lightbox="{{ page.url }}"
      {% if found.caption %}
        data-title="{{ found.caption }}"
      {% endif %}
    >
      <img
        src="{{ image_path }}"
        alt="{{ found.title | default: found.caption | escape }}"
        class="img-fluid rounded image-shadow"
        onerror="this.onerror=null;this.src='{{ placeholder_path }}';"
      >
    </a>

  {% else %}
    <img
      src="{{ image_path }}"
      alt="{{ found.title | default: found.caption | escape }}"
      class="img-fluid rounded image-shadow"
      onerror="this.onerror=null;this.src='{{ placeholder_path }}';"
    >
  {% endif %}

  {% if found.caption %}
    <figcaption class="caption">
      {{ found.caption }}
    </figcaption>
  {% endif %}
{% endif %}
