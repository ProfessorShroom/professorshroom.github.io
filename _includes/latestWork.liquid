{% assign latest_items = '' | split: '' %}
{% for candidate in site.posts %}
  {% assign candidate_tags = candidate.tags | join: '|' | downcase | split: '|' %}
  {% if candidate_tags contains 'guide' or candidate_tags contains 'guides' %}
    {% unless candidate.ignore_latest %}
      {% assign latest_items = latest_items | push: candidate %}
    {% endunless %}
  {% endif %}
{% endfor %}
{% for project in site.projects %}
  {% unless project.ignore_latest %}
    {% assign latest_items = latest_items | push: project %}
  {% endunless %}
{% endfor %}
{% comment %}
  Sort newest first by `updated` if set, otherwise `date`.
  Liquid can't sort by a computed value, so build sortable keys (timestamp-index), sort those, then look the items back up by index.
{% endcomment %}
{% assign sort_keys = '' | split: '' %}
{% for item in latest_items %}
  {% assign item_stamp = item.updated | default: item.date | date: '%Y%m%d%H%M%S' %}
  {% assign item_idx = forloop.index0 | plus: 10000 %}
  {% capture sort_key %}{{ item_stamp }}-{{ item_idx }}{% endcapture %}
  {% assign sort_keys = sort_keys | push: sort_key %}
{% endfor %}
{% assign sort_keys = sort_keys | sort | reverse %}

{% if latest_items.size > 0 %}
  <section class="latest-work">
    <h2>Latest guides and projects</h2>
    <ul class="post-list">
      {% for sort_key in sort_keys limit: 6 %}
        {% assign item_pos = sort_key | split: '-' | last | minus: 10000 %}
        {% assign item = latest_items[item_pos] %}
        {% if item.collection == 'projects' %}
          {% assign item_type = 'Project' %}
          {% if item.redirect %}
            {% assign item_href = item.redirect %}
          {% else %}
            {% assign item_href = item.url | relative_url %}
          {% endif %}
          {% assign item_image = item.img %}
          {% assign item_label = item.category %}
          {% assign item_fit = 'contain' %}
        {% else %}
          {% assign item_type = 'Guide' %}
          {% assign guide_target = item.guide_url | default: item.url %}
          {% assign item_href = guide_target | relative_url %}
          {% assign item_image = item.thumbnail %}
          {% assign item_label = item.categories | first %}
          {% assign item_fit = 'cover' %}
        {% endif %}
        <li>
          <div class="row">
            <div class="col-sm-9">
              <p class="post-meta">
                {% if item_label %}
                  <span class="category-pill">{{ item_label }}</span>
                {% endif %}
                {% if item.updated %}
                  <span>{{ item_type }} &nbsp; &middot; &nbsp; Updated {{ item.updated | date: '%B %d, %Y' }}</span>
                {% else %}
                  <span>{{ item_type }} &nbsp; &middot; &nbsp; {{ item.date | date: '%B %d, %Y' }}</span>
                {% endif %}
              </p>
              <h3>
                <a class="post-title" href="{{ item_href }}">{{ item.title }}</a>
              </h3>
              <p>{{ item.description }}</p>
            </div>
            <div class="col-sm-3">
              {% if item_image %}
                <img
                  class="card-img"
                  src="{{ item_image | relative_url }}"
                  style="object-fit: {{ item_fit }}; height: 90%"
                  alt=""
                  loading="lazy"
                  decoding="async"
                >
              {% else %}
                <div class="thumb-placeholder" aria-hidden="true">
                  <span>{{ item_label | default: item_type }}</span>
                </div>
              {% endif %}
            </div>
          </div>
        </li>
      {% endfor %}
    </ul>
    <a class="latest-work-links" href="{{ '/guides/' | relative_url }}">Browse all guides &rarr;</a>
    &nbsp;&nbsp;
    <a class="latest-work-links" href="{{ '/projects/' | relative_url }}">See all projects &rarr;</a>
  </section>
{% endif %}
