<div class="project-list-item">
  <a
    href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}"
    class="project-list-link"
  >
    <div class="project-hover-shell">
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes="220px"
          alt="project thumbnail"
          class="project-list-thumb"
        %}
      {% endif %}

      <div class="project-list-content">
        <h3 class="project-list-title">{{ project.title }}</h3>
        <p class="project-list-description">{{ project.description }}</p>

        {% if project.github %}
          <div class="project-list-meta">
            <i class="fa-brands fa-github gh-icon"></i>
            {% if project.github_stars %}
              <span class="stars">
                <i class="fa-solid fa-star"></i>
                <span id="{{ project.github_stars }}-stars"></span>
              </span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </a>
</div>
